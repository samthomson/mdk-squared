# --- nostr / auth -----------------------------------------------------------
# The bootstrap admin (bech32 npub). This npub can always sign in and manage
# members even before/without a Marmot group.
ADMIN_NPUB=npub1replace-me

# --- server -----------------------------------------------------------------
PORT=8080
# Nostr relays used for: NIP-98 auth is local (no relay needed), the PM2.5
# autopilot station feed, and Marmot group transport.
RELAYS=wss://relay.relaying.earth

# --- MDK plane ---------------------------------------------------------------
# Private HyperDHT on loopback: kernel, worker and app client all join it.
DHT_HOST=127.0.0.1
DHT_PORT=49737
WORKER_ID=bitair

# --- devices -----------------------------------------------------------------
# Mock BitAirs (no hardware needed). MOCK_COUNT devices on MOCK_PORT_BASE..+N
MOCK_COUNT=3
MOCK_PORT_BASE=18100
# Real devices instead of mocks (wins when set), e.g.:
# REAL_DEVICES=[{"id":"BA-001","host":"192.168.1.50","port":80},{"id":"BA-002","host":"192.168.1.51","port":80}]

# --- autopilot ----------------------------------------------------------------
AUTOPILOT_ON_UGM3=35
AUTOPILOT_OFF_UGM3=25
AUTOPILOT_DEFAULT_IDLE_MODE=eco

# --- marmot --------------------------------------------------------------------
MARMOT_ENABLED=true

# --- persistence ----------------------------------------------------------------
DATA_DIR=./data
